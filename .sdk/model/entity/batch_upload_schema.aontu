# Entity: batch_upload_schema

main: kit: entity: batch_upload_schema: {

  alias: field: {}

  fields: {
    added: {
      h: "Added"
      n: "added"
      r: false
      sh: "The number of entries that were inserted"
      t: "`$INTEGER`"
    }
    deleted: {
      h: "Deleted"
      n: "deleted"
      r: false
      sh: "The number of entries that were deleted (on applicable if `truncate: true`)"
      t: "`$INTEGER`"
    }
    entries: {
      h: "Entries"
      n: "entries"
      r: true
      sh: "The list of schema entries to upload"
      t: "`$ARRAY`"
    }
    truncate: {
      h: "Truncate"
      n: "truncate"
      r: false
      sh: "If true, delete your entire data dictionary before inserting these entries."
      t: "`$BOOLEAN`"
    }
  }

  name: "batch_upload_schema"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /projects/{projectId}/schemas"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/projects/{projectId}/schemas"
          q: {
            exist: [
              "project_id"
            ]
          }
          r: {
            param: {
              projectId: "project_id"
            }
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "schemas"
            }
          ]
          t: {
            req: {
              entries: "`reqdata.entry`"
              truncate: "`reqdata.truncate`"
            }
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
